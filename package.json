{
  "name": "humanifyjs",
  "version": "2.2.2",
  "description": "Deobfuscate a minified JavaScript bundle into a readable, version-stable source tree. The pipeline is the Rust binary (crates/humanify-cli); this package holds its measurement harness.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run check",
    "test:unit": "find test experiments -name '*.test.ts' -not -path '*/node_modules/*' -not -path '*/.tmp-clone/*' -not -path '*/results/*' | xargs tsx --test",
    "test:e2e": "tsx scripts/e2e.ts",
    "lint": "npm run lint:prettier && npm run lint:biome",
    "lint:prettier": "prettier --check 'test/**/*.ts' 'scripts/**/*.ts' 'experiments/**/lib/**/*.ts'",
    "lint:biome": "biome check test/ scripts/ experiments/lib/",
    "check": "tsx scripts/check.ts",
    "check:all": "npm run check",
    "knip": "knip",
    "knip:prod": "knip --production --tags=-internal",
    "prepare": "husky",
    "eval": "tsx scripts/eval.ts",
    "census:clones": "tsx scripts/clone-census.ts"
  },
  "type": "module",
  "keywords": [
    "humanify",
    "decompiler",
    "decompile",
    "unobfuscate",
    "unobfuscator",
    "deobfuscate",
    "deobfuscator",
    "decompile",
    "decompiler",
    "reverse engineering",
    "unminify",
    "unuglify",
    "llm",
    "llama",
    "openai",
    "chatgpt"
  ],
  "author": "Jesse Luoto",
  "license": "MIT",
  "dependencies": {
    "webcrack": "^2.13.0"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write",
    "*.{ts,js}": "biome check --write --no-errors-on-unmatched",
    "*.rs": "scripts/rustfmt-staged.sh"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/traverse": "^7.25.2",
    "@babel/types": "^7.25.2",
    "@biomejs/biome": "^2.4.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "private": true
}
