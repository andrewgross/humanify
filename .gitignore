# The small fixture's boundary is MEASURED off its committed source and
# build (wrapper-binding counts, see its README) — the source is part of
# the fixture's proof, so it is tracked where the other fixtures' local
# source trees are not.
!test/e2e/fixtures/esbuild-bundle-small/source/
test/e2e/fixtures/*/minified/
.env
dist.tar.gz

node_modules/

.idea/
.claude/

split-output/

# Eval run logs. The per-run JSON summaries under
# `dev/eval/results/<label>/` ARE committed — they are the
# references later runs are scored against — but the raw pipeline logs beside
# them are not, and never have been (0 of them are tracked). They are also
# ~10 GB, so with nothing ignoring them every `git status` listed them and a
# `git add -A` at the repo root would have tried to commit all of it.
dev/eval/results/*/*.log
dev/eval/results/*/*.stdout

# Local dev environment and host-specific planning notes: not project
# infrastructure, not usable by anyone cloning this repo, and this repo is
# public. Both were committed incidentally in an unrelated experiment commit
# rather than by decision.
.devcontainer/
docs/plan-server-migration.md
# The LLM server's address (`cargo dev` reads it: committed::local). Per-machine,
# and private: the `no-private-addresses` gate stage fails on one in a tracked file.
.humanify.local.json
# The harness's labels stay local. Library labels are never committed;
# the few committed eval references are force-added.
dev/eval/results/*
dev/library/results/

# experiments/: only the write-ups (proposal and conclusions, Markdown) are
# committed. Raw outputs, scripts, data, fixtures and generated tables stay
# local, so a run's output can never be committed by accident.
/experiments/**
!/experiments/**/
!/experiments/**/*.md
/experiments/*/tables/

# Rust workspace build output (rust-port migration)
/target/

# python bytecode (experiment lab scripts)
__pycache__/
