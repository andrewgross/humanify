+
+/// exp126: the library units' declaration-kind rule. A published library
+/// re-minified by an app's build reaches the bundle with its `const` / `let`
+/// spelled `var` (a minifier's or a downlevel's choice, not the library's
+/// code); the unit form walks all three as `var`. Every cross-version form
+/// keeps the keyword.
+mod declaration_kinds {
+    use super::*;
+    use crate::hash::forms::LIBRARY_UNITS;
+
+    fn units(code: &str) -> String {
+        hash_of(code, &LIBRARY_UNITS)
+    }
+
+    #[test]
+    fn library_units_walk_const_and_let_as_var() {
+        let var = units("var a = f(1), b = [a];");
+        assert_eq!(units("const a = f(1), b = [a];"), var);
+        assert_eq!(units("let a = f(1), b = [a];"), var);
+        assert_eq!(
+            units("function g(){ for (let i = 0; i < 3; i++) { const x = i; h(x); } }"),
+            units("function g(){ for (var i = 0; i < 3; i++) { var x = i; h(x); } }"),
+            "nested declarations unify too"
+        );
+        // only the keyword: the declarations themselves still count
+        assert_ne!(units("const a = f(1);"), units("var a = f(2);"));
+    }
+
+    #[test]
+    fn cross_version_forms_keep_the_keyword() {
+        assert_ne!(matchkey("const a = f(1);"), matchkey("var a = f(1);"));
+        assert_ne!(matchkey("let a = f(1);"), matchkey("var a = f(1);"));
+        assert_ne!(verbatim("const a = f(1);"), verbatim("var a = f(1);"));
+    }
+}
