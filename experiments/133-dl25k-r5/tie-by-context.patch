diff --git a/crates/humanify-core/src/libindex/lookup_test.rs b/crates/humanify-core/src/libindex/lookup_test.rs
index 6bec259b1..e276206f7 100644
--- a/crates/humanify-core/src/libindex/lookup_test.rs
+++ b/crates/humanify-core/src/libindex/lookup_test.rs
@@ -629,3 +629,36 @@ fn the_loader_reads_the_helper_table_when_the_index_has_one() {
     assert_eq!(rows.helper_owners(&hx("h")), ["@babel/runtime".to_string()]);
     std::fs::remove_dir_all(&dir).ok();
 }
+
+#[test]
+fn a_tie_goes_to_the_owner_holding_the_code_in_the_smallest_module_with_tie_by_context() {
+    // exp133: a bigger index adds sponges (a package whose dist inlines a
+    // dependency). A whole print both hold is a tie; by name the scoped
+    // sponge sorts first and wins. The origin holds the code in its OWN,
+    // smaller module; the sponge only inside its bigger dist.
+    let index = LibraryIndex::from_rows(
+        vec![
+            row("ajv", "@sponge/mcp", 150, 8000),
+            row("ajv", "ajv", 150, 900),
+        ],
+        vec![],
+    );
+    let q = [whole("ajv", 150)];
+    assert_eq!(
+        claims(&index, &q, structural()),
+        vec![(0, "@sponge/mcp".into())]
+    );
+    let by_context = LookupRules {
+        tie_by_context: true,
+        ..structural()
+    };
+    assert_eq!(claims(&index, &q, by_context), vec![(0, "ajv".into())]);
+    let close = LibraryIndex::from_rows(
+        vec![
+            row("ajv", "@sponge/mcp", 150, 6000),
+            row("ajv", "ajv", 150, 900),
+        ],
+        vec![],
+    );
+    assert_eq!(claims(&close, &q, by_context), vec![(0, "@sponge/mcp".into())]);
+}
